# Toolchains and downloads. They live in $RUCC_CROSS_CACHE, which is ~/.cache/rucc-cross by
# default and outside the checkout on purpose, so nothing here should ever appear. These lines are
# for the person who set the cache to the working directory and then wondered why git noticed.
/cache
*.tar.gz
*.tar.xz
*.tar.bz2
*.zip

# Build output from a corpus run that was interrupted before its temporary directory went away.
*.o
*.obj
*.exe
/out

# Editor and OS noise
.DS_Store
.idea/
.vscode/
*.swp
