#!/bin/sh
# The house rules, in one command.
#
# usage: bin/lint
#
# Three prose rules and one shell rule. The prose rules are the same two the compiler repository
# checks in `cargo xtask style`, plus one for the trailing whitespace that a table of tab separated
# records invites, so that a paragraph can move between the two repositories without being
# reformatted on arrival.
#
# The shell rule is shellcheck, if it is installed. Everything here is POSIX sh on purpose: this
# repository is an environment and a corpus rather than a program, and the day it needs a language
# with a build system is the day somebody should ask whether the thing being built belongs in the
# compiler repository instead.

set -eu

here=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
cd "$here"

problems=0
report() {
	printf '%s\n' "$1" >&2
	problems=$((problems + 1))
}

markdown=$(find . -name '*.md' -not -path './.git/*' | sort)
# Every file in the two script directories that says it is one, found rather than listed. A list
# here would be a second place to remember a new script, and the thing it is remembered for is the
# check that the script is executable, which is exactly the check a forgotten script escapes.
scripts=$(grep -l '^#!/bin/sh' bin/* toolchains/* | sort)

# An em dash or an en dash. The rule is that a sentence which needs one is a sentence that wanted a
# comma, a colon, a period or the word "to", and picking one of those is the author's job.
for file in $markdown; do
	if grep -n '[—–]' "$file" >/dev/null 2>&1; then
		grep -n '[—–]' "$file" | while IFS= read -r hit; do
			printf '%s:%s: em or en dash\n' "$file" "$hit" >&2
		done
		report "$file has an em or en dash"
	fi
done

# A horizontal rule, which is a page break wearing a costume. A heading says what the next part is
# and a rule says only that there is one.
for file in $markdown; do
	if awk 'NR > 1 && $0 == "---" { exit 0 } END { exit 1 }' "$file"; then
		report "$file has a horizontal rule, and a heading would say what the next part is"
	fi
done

# Trailing whitespace, which matters more here than usual because the data files are tab separated
# and a stray tab at the end of a record is an empty field nobody can see.
for file in $markdown targets toolchains/manifest sysroots/manifest sysroots/distribution-patches \
	sysroots/glibc-version-changes $scripts; do
	if grep -n '[ 	]$' "$file" >/dev/null 2>&1; then
		report "$file has trailing whitespace"
	fi
done

# Every record in the data files has the number of fields its header promises.
if awk -F'\t' '/^[^#]/ && NF > 0 && NF != 4 { print FILENAME ":" NR ": " NF " fields, want 4"; bad = 1 } END { exit bad ? 1 : 0 }' targets; then
	:
else
	report "targets has a record with the wrong number of fields"
fi
if awk -F'\t' '/^[^#]/ && NF > 0 && NF != 5 { print FILENAME ":" NR ": " NF " fields, want 5"; bad = 1 } END { exit bad ? 1 : 0 }' toolchains/manifest; then
	:
else
	report "toolchains/manifest has a record with the wrong number of fields"
fi
if awk -F'\t' '/^[^#]/ && NF > 0 && NF != 5 { print FILENAME ":" NR ": " NF " fields, want 5"; bad = 1 } END { exit bad ? 1 : 0 }' sysroots/manifest; then
	:
else
	report "sysroots/manifest has a record with the wrong number of fields"
fi
if awk -F'\t' '/^[^#]/ && NF > 0 && NF != 4 { print FILENAME ":" NR ": " NF " fields, want 4"; bad = 1 } END { exit bad ? 1 : 0 }' sysroots/distribution-patches; then
	:
else
	report "sysroots/distribution-patches has a record with the wrong number of fields"
fi
if awk -F'\t' '/^[^#]/ && NF > 0 && NF != 4 { print FILENAME ":" NR ": " NF " fields, want 4"; bad = 1 } END { exit bad ? 1 : 0 }' sysroots/glibc-version-changes; then
	:
else
	report "sysroots/glibc-version-changes has a record with the wrong number of fields"
fi

# The rows of one source in sysroots/manifest are in descending version order, because the first row
# of a kind is the pin and every later one is a comparison. That is written down in the header of the
# file and there is nothing in the format that enforces it, so a new release appended at the bottom
# the way a new row of any other file would be leaves the pin where it was: the tree we ship and the
# stubs we generate stay on the old release, everything still builds, and the only sign is that the
# new release turns up in the comparison runs and nowhere else.
if awk -F'\t' '
	function newer(a, b) {
		n = split(a, x, ".")
		m = split(b, y, ".")
		k = n > m ? n : m
		for (i = 1; i <= k; i++) {
			u = (i <= n ? x[i] + 0 : 0)
			v = (i <= m ? y[i] + 0 : 0)
			if (u != v) {
				return u > v
			}
		}
		return 0
	}
	/^[^#]/ && NF > 0 {
		if ($1 in last && !newer(last[$1], $2)) {
			print FILENAME ":" NR ": " $1 " " $2 " is not older than the " $1 " row above it, which is " last[$1]
			bad = 1
		}
		last[$1] = $2
	}
	END { exit bad ? 1 : 0 }' sysroots/manifest; then
	:
else
	report "sysroots/manifest has a source whose versions are not in descending order, and the first row of a source is the pin"
fi

# Every script is executable, because one that is not is a file somebody has to know to run with
# sh, and they will not.
for script in $scripts; do
	[ -x "$script" ] || report "$script is not executable"
done

if command -v shellcheck >/dev/null 2>&1; then
	# shellcheck disable=SC2086
	shellcheck -s sh $scripts || report "shellcheck had something to say"
else
	printf 'lint: no shellcheck on this machine, so the shell rules were not checked\n' >&2
fi

if [ "$problems" -eq 0 ]; then
	printf 'lint: clean\n' >&2
else
	printf 'lint: %d problems\n' "$problems" >&2
	exit 1
fi
