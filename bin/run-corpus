#!/bin/sh
# Compile the executing corpus for a target, run it, and compare the output against the expected
# transcript.
#
# usage: bin/run-corpus [--cc reference|rucc] [tuple]...
#
# Either compiler can be the one under test. The reference is the default, because a transcript this
# repository records has to come from something independent of rucc before it is worth comparing
# anything against, and `--cc rucc` is the comparison itself: the same sources, the same expected
# files, the same runners, and rucc reading the sysroot bin/sysroot produced for the target.
#
# With no arguments it does every row of the targets table that has a runner, which is the Linux
# rows, because qemu user mode runs Linux binaries and a Mach-O or a PE needs a different answer.
# Whether the binary ran on hardware or under an emulator is recorded on every line, because
# spec/cross-compile/14-testing.md section 14.6 says a failure seen only under emulation leaves the
# emulator a suspect and a result that does not say which it was cannot be read that way.
#
# The expected transcript is the same file for every target. That is the whole design: the corpus
# prints values rather than sizes, so a target that prints something different has miscounted a
# register or a stack slot. A per target expected file would turn a bug into a recorded fact.
#
# A skipped row says why it was skipped, and the reasons are specific. "Skipped" with no reason is
# a result that reads as coverage and is not, which over a few months is how a table of targets
# stops meaning anything.

set -eu

here=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
cache=${RUCC_CROSS_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/rucc-cross}

die() { printf 'run-corpus: %s\n' "$*" >&2; exit 1; }

cc=reference
while [ $# -gt 0 ]; do
	case $1 in
	--cc)
		[ $# -ge 2 ] || die "--cc wants reference or rucc after it"
		cc=$2
		shift 2
		;;
	--cc=*)
		cc=${1#--cc=}
		shift
		;;
	*) break ;;
	esac
done
case $cc in
reference) compile=$here/bin/reference-cc ;;
rucc) compile=$here/bin/rucc-cc ;;
*) die "--cc is $cc, and it has to be reference or rucc" ;;
esac

if [ $# -gt 0 ]; then
	tuples=$*
else
	tuples=$(awk -F'\t' '/^[^#]/ && NF > 1 && $4 != "-" { print $1 }' "$here/targets")
fi

# The tuple this machine is, so that a target matching it runs directly rather than under qemu.
machine=$(uname -m)
case $machine in
x86_64 | amd64) machine=x86_64 ;;
aarch64 | arm64) machine=aarch64 ;;
*) machine=unknown ;;
esac
case $(uname -s) in
Linux) kernel=linux ;;
Darwin) kernel=macos ;;
*) kernel=unknown ;;
esac
case $kernel in
linux) native=$machine-linux-gnu ;;
*) native=$machine-$kernel ;;
esac

out=$(mktemp -d)
trap 'rm -rf "$out"' EXIT INT TERM

passed=0
failed=0
skipped=0

for tuple in $tuples; do
	runner=$(awk -F'\t' -v t="$tuple" '$1 == t { print $4 }' "$here/targets")
	[ -n "$runner" ] || die "$tuple is not a row of the targets table"

	# Static where it is possible, because a statically linked binary is one fewer thing that
	# can be wrong about a cross build and qemu user mode needs no interpreter path for it.
	# Three groups cannot have that, for three different reasons.
	#
	# Darwin has no static libSystem and has not had one since 10.6, so those rows link
	# dynamically and run on the machine they were built on.
	#
	# glibc is the same answer from the other direction: what zig ships is a set of stubs it
	# links against and there is no static build of it, so the glibc rows link dynamically
	# too. That leaves them runnable on the machine they were built for and not under qemu
	# user mode, which would need the target's loader and its shared libc sitting on this
	# disk. Fetching a glibc runtime per architecture is what document 13 is about and not
	# something a test script should be doing behind the person running it.
	#
	# The android rows have no libc here at all. zig carries bionic's headers and not bionic,
	# so nothing links and there is nothing to run. They are still covered by
	# bin/compile-corpus, which is `-c` and needs no libc.
	link=-static
	reason=""
	case $tuple in
	*-macos | *-ios*)
		link=""
		;;
	*-android | *-android.*)
		reason="zig carries bionic's headers and not bionic, so nothing links"
		;;
	*-linux-gnu | *-linux-gnu.* | *-linux-gnueabi* | *-linux-gnux32)
		link=""
		if [ "$tuple" != "$native" ]; then
			reason="glibc links dynamically and its loader for $tuple is not on this machine"
		fi
		;;
	esac

	# Two more reasons when rucc is the compiler, and both of them are about rucc rather than about
	# this machine. It reads the sysroot this repository produced, so a row nobody has run
	# bin/sysroot for has nothing to compile against, and it has one back end, so every row that is
	# not x86-64 is a row the compiler says no to itself. Naming them here rather than letting the
	# build fail keeps a missing sysroot from reading like a miscompilation.
	#
	# Before the emulator question below, because these two are true on every machine and the
	# emulator is true on this one. A row rucc cannot compile for reads better as that than as a
	# missing qemu, which somebody would otherwise go and install for nothing.
	if [ -z "$reason" ] && [ "$cc" = rucc ]; then
		if [ ! -d "$cache/sysroots/$tuple" ]; then
			reason="no sysroot for $tuple has been produced, so run bin/sysroot $tuple"
		else
			case $tuple in
			x86_64-*) ;;
			*) reason="rucc has no back end for ${tuple%%-*} yet" ;;
			esac
		fi
	fi

	if [ -n "$reason" ]; then
		printf '%-24s skipped, %s\n' "$tuple" "$reason"
		skipped=$((skipped + 1))
		continue
	fi

	# Where it runs, which is hardware when this machine can execute it and the table's emulator
	# otherwise. Two cases are hardware. The row that is this machine, and a static binary for this
	# machine's architecture and kernel, because a static binary carries its libc and the kernel
	# does not care which one it was: x86_64-linux-musl on an x86_64 Linux box runs here, and
	# running it here rather than under qemu takes the emulator out of the picture for the one row
	# the compiler can currently build. Nothing else is assumed, so i686 on x86_64 still goes
	# through qemu-i386 even though the kernel would take it.
	how=emulated
	os=$(printf '%s\n' "$tuple" | cut -d- -f2)
	if [ "$tuple" = "$native" ] ||
		{ [ "$link" = -static ] && [ "${tuple%%-*}" = "$machine" ] && [ "$os" = "$kernel" ]; }; then
		runner=""
		how=hardware
	elif [ "$runner" = "-" ] || ! command -v "$runner" >/dev/null 2>&1; then
		printf '%-24s skipped, no %s on this machine\n' "$tuple" "${runner:--}"
		skipped=$((skipped + 1))
		continue
	fi

	for level in -O0 -O2; do
		for source in "$here"/corpus/abi/*.c "$here"/corpus/exec/*.c; do
			name=$(basename "$source" .c)
			expected=$(dirname "$source")/$name.expected
			[ -f "$expected" ] || die "$source has no expected transcript beside it"

			binary=$out/$name
			# shellcheck disable=SC2086
			if ! "$compile" "$tuple" -std=c17 -Wall -Wextra -Werror \
				"$level" $link -o "$binary" "$source" 2>"$out/build.log"; then
				printf '%-24s %-12s %-4s did not build\n' "$tuple" "$name" "$level"
				sed 's/^/    /' "$out/build.log" >&2
				failed=$((failed + 1))
				continue
			fi

			# shellcheck disable=SC2086
			if ! $runner "$binary" >"$out/got" 2>&1; then
				printf '%-24s %-12s %-4s exited nonzero, %s\n' "$tuple" "$name" "$level" "$how"
				sed 's/^/    /' "$out/got" >&2
				failed=$((failed + 1))
				continue
			fi

			if diff -u "$expected" "$out/got" >"$out/diff"; then
				printf '%-24s %-12s %-4s ok, %s\n' "$tuple" "$name" "$level" "$how"
				passed=$((passed + 1))
			else
				printf '%-24s %-12s %-4s wrong output, %s\n' "$tuple" "$name" "$level" "$how"
				sed 's/^/    /' "$out/diff" >&2
				failed=$((failed + 1))
			fi
		done
	done
done

printf 'corpus: %s, %d ran, %d failed, %d skipped\n' "$cc" "$passed" "$failed" "$skipped" >&2
[ "$failed" -eq 0 ]
