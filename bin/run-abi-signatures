#!/bin/sh
# Build the compiler's signature corpus with the reference and run it, on every target that has a
# way to run a binary.
#
# usage: bin/run-abi-signatures [--cc reference|rucc] [directory] [tuple]...
#
# The directory holds the output of `cargo xtask abi-signatures` in the compiler repository. It
# defaults to $RUCC_ABI_SIGNATURES and then to ../rucc/tests/abi-signatures, which is where it is
# when the two repositories sit side by side.
#
# With `--cc reference`, the default, this is the reference against reference build of the four
# that spec/cross-compile/14-testing.md section 14.3 describes, run on every architecture rather
# than on the ones with a back end. With `--cc rucc` it is all four: the caller and the callee are
# each built once with rucc and once with the reference, and every pairing is linked and run, so a
# row fails when rucc disagrees with the reference about where any argument or return value goes.
# The control alone is worth running for two reasons.
#
# The corpus is generated, and a generated program is a program nobody read. Compiling it for every
# row already catches the shapes the reference rejects, and bin/compile-abi-signatures does that.
# Running it catches the ones the reference accepts and then gets wrong, or that the corpus is
# wrong about: a value checked against the wrong promoted type, an aggregate whose initializer does
# not match the check, a `long double` whose bit pattern differs between architectures. Those are
# corpus bugs and they are far cheaper to find here than inside a differential where the answer is
# supposed to mean something about rucc.
#
# The second reason is section 14.4's divergence list. Every architecture's emulator has to be
# characterized before an emulated pass is worth anything, and the way to characterize it is to run
# a program whose answer is known on it, many times. That is exactly this. A crash here is qemu,
# because every instruction in the binary came from the reference compiler, and the retry count is
# printed rather than swallowed so the rate can be read off the log.
#
# What runs: the musl rows and the row this machine is. The glibc rows link dynamically against a
# loader and a libc that are not on this disk, the android rows have no bionic here at all, and the
# Darwin and Windows rows need a different kind of emulator than qemu user mode. run-corpus gives
# the same reasons at more length and skips the same rows, on purpose, so the two runners cover the
# same set and a target does not quietly appear in one and not the other.
#
# In the rucc mode the rows are the ones rucc has a back end for, which today is x86-64 and
# AArch64, and each needs the sysroot bin/sysroot produced. rucc writes assembly and the reference
# assembles it, since rucc does not write an AArch64 object yet, and report.c is always built by
# the reference because it is the half that prints. The rucc halves are built at -O0 and at -O2,
# because the reference halves do not change and a convention rucc gets right at one level and
# wrong at the other is still wrong.

set -eu

here=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
cache=${RUCC_CROSS_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/rucc-cross}

die() { printf 'run-abi-signatures: %s\n' "$*" >&2; exit 1; }

cc=reference
while [ $# -gt 0 ]; do
	case $1 in
	--cc)
		[ $# -ge 2 ] || die "--cc wants reference or rucc after it"
		cc=$2
		shift 2
		;;
	--cc=*)
		cc=${1#--cc=}
		shift
		;;
	*) break ;;
	esac
done
case $cc in
reference | rucc) ;;
*) die "--cc is $cc, and it has to be reference or rucc" ;;
esac

corpus=${RUCC_ABI_SIGNATURES:-$here/../rucc/tests/abi-signatures}
if [ $# -gt 0 ] && [ -d "$1" ]; then
	corpus=$1
	shift
fi
[ -d "$corpus" ] || die "$corpus is not a directory, generate it with cargo xtask abi-signatures"
for name in abi.h caller.c callee.c report.c; do
	[ -f "$corpus/$name" ] || die "$corpus has no $name in it"
done

if [ $# -gt 0 ]; then
	tuples=$*
else
	tuples=$(awk -F'\t' '/^[^#]/ && NF > 1 && $4 != "-" { print $1 }' "$here/targets")
fi

# How many times a crash is tried again before it is reported. Three, for the reason in
# xtask/src/differential.rs in the compiler repository: qemu drops programs on the floor at a rate
# that is small but is not zero, and a harness that reports the first crash as a finding sends
# somebody after a bug that is not there. A wrong value is believed the first time, because no
# emulator has ever been observed to change one number in a program and leave it running.
TRIES=3

machine=$(uname -m)
case $machine in
x86_64 | amd64) machine=x86_64 ;;
aarch64 | arm64) machine=aarch64 ;;
*) machine=unknown ;;
esac
case $(uname -s) in
Linux) kernel=linux ;;
Darwin) kernel=macos ;;
*) kernel=unknown ;;
esac
case $kernel in
linux) native=$machine-linux-gnu ;;
*) native=$machine-$kernel ;;
esac

out=$(mktemp -d)
trap 'rm -rf "$out"' EXIT INT TERM

passed=0
failed=0
skipped=0
retried=0

for tuple in $tuples; do
	runner=$(awk -F'\t' -v t="$tuple" '$1 == t { print $4 }' "$here/targets")
	[ -n "$runner" ] || die "$tuple is not a row of the targets table"

	link=-static
	reason=""
	case $tuple in
	*-macos | *-ios*)
		link=""
		;;
	*-android | *-android.*)
		reason="zig carries bionic's headers and not bionic, so nothing links"
		;;
	*-linux-gnu | *-linux-gnu.* | *-linux-gnueabi* | *-linux-gnux32)
		link=""
		if [ "$tuple" != "$native" ]; then
			reason="glibc links dynamically and its loader for $tuple is not on this machine"
		fi
		;;
	esac

	# The same two reasons bin/run-corpus gives, for the same rows: rucc reads the sysroot this
	# repository produced and it has two back ends, and a row it cannot compile for should say
	# that rather than look like a miscompilation or a missing emulator.
	if [ -z "$reason" ] && [ "$cc" = rucc ]; then
		if [ ! -d "$cache/sysroots/$tuple" ]; then
			reason="no sysroot for $tuple has been produced, so run bin/sysroot $tuple"
		else
			case $tuple in
			x86_64-* | aarch64-*) ;;
			*) reason="rucc has no back end for ${tuple%%-*} yet" ;;
			esac
		fi
	fi

	if [ -n "$reason" ]; then
		printf '%-24s skipped, %s\n' "$tuple" "$reason"
		skipped=$((skipped + 1))
		continue
	fi

	# Hardware where this machine can execute it, which is the row this machine is and any static
	# row for the same architecture and kernel, because a static binary carries its libc. The same
	# rule as bin/run-corpus, and the same reason for having it: a result from hardware leaves the
	# emulator out of the list of suspects.
	how=emulated
	os=$(printf '%s\n' "$tuple" | cut -d- -f2)
	if [ "$tuple" = "$native" ] ||
		{ [ "$link" = -static ] && [ "${tuple%%-*}" = "$machine" ] && [ "$os" = "$kernel" ]; }; then
		runner=""
		how=hardware
	elif [ "$runner" = "-" ] || ! command -v "$runner" >/dev/null 2>&1; then
		printf '%-24s skipped, no %s on this machine\n' "$tuple" "${runner:--}"
		skipped=$((skipped + 1))
		continue
	fi

	# The reference halves at -O0, the level the differential harness uses, and for its reason: a
	# calling convention is not an optimization. Nothing is inlined across the boundary anyway,
	# because the two halves are separate translation units.
	built=true
	for half in caller callee report; do
		# shellcheck disable=SC2086
		if ! "$here/bin/reference-cc" "$tuple" -std=c17 -Wall -Wextra -Werror -O0 \
			-I "$corpus" -c -o "$out/ref-$half.o" "$corpus/$half.c" 2>"$out/build.log"; then
			printf '%-24s did not build %s.c with the reference\n' "$tuple" "$half"
			sed 's/^/    /' "$out/build.log" >&2
			built=false
			break
		fi
	done
	if ! $built; then
		failed=$((failed + 1))
		continue
	fi

	pairs="ref-caller:ref-callee"
	if [ "$cc" = rucc ]; then
		for level in 0 2; do
			for half in caller callee; do
				if ! "$here/bin/rucc-cc" "$tuple" -std=c17 -O$level -I "$corpus" -S \
					-o "$out/rucc$level-$half.s" "$corpus/$half.c" 2>"$out/build.log" ||
					! "$here/bin/reference-cc" "$tuple" -c -o "$out/rucc$level-$half.o" \
						"$out/rucc$level-$half.s" 2>>"$out/build.log"; then
					printf '%-24s did not build %s.c with rucc at -O%s\n' \
						"$tuple" "$half" "$level"
					sed 's/^/    /' "$out/build.log" >&2
					built=false
					break 2
				fi
			done
			pairs="$pairs ref-caller:rucc$level-callee rucc$level-caller:ref-callee"
			pairs="$pairs rucc$level-caller:rucc$level-callee"
		done
	fi
	if ! $built; then
		failed=$((failed + 1))
		continue
	fi

	for pair in $pairs; do
		caller=${pair%%:*}
		callee=${pair#*:}
		label=$tuple
		[ "$cc" = reference ] || label="$tuple $caller $callee"
		binary=$out/sig
		# shellcheck disable=SC2086
		if ! "$here/bin/reference-cc" "$tuple" $link -o "$binary" "$out/$caller.o" \
			"$out/$callee.o" "$out/ref-report.o" 2>"$out/build.log"; then
			printf '%-24s did not link\n' "$label"
			sed 's/^/    /' "$out/build.log" >&2
			failed=$((failed + 1))
			continue
		fi

		try=1
		while :; do
			# The status is read in the else branch rather than after the whole `if`, because
			# after a failed condition with no else the `if` itself has succeeded and `$?` is 0.
			# shellcheck disable=SC2086
			if $runner "$binary" >"$out/got" 2>&1; then
				if [ "$try" -gt 1 ]; then
					printf '%-24s ok, %s, after %d tries\n' "$label" "$how" "$try"
				else
					printf '%-24s ok, %s\n' "$label" "$how"
				fi
				passed=$((passed + 1))
				break
			else
				status=$?
			fi

			# Anything at or above 128 is a signal, which is the shape a qemu drop takes. The
			# corpus itself exits 1 when a value arrived in the wrong place, and that is an
			# answer rather than an accident, so it is reported the first time.
			if [ "$status" -lt 128 ] || [ "$try" -ge "$TRIES" ]; then
				printf '%-24s failed with status %d, %s, on try %d\n' \
					"$label" "$status" "$how" "$try"
				sed 's/^/    /' "$out/got" >&2
				failed=$((failed + 1))
				break
			fi

			retried=$((retried + 1))
			try=$((try + 1))
		done
	done
done

printf 'abi-signatures: %d ran, %d failed, %d skipped, %d crashes tried again\n' \
	"$passed" "$failed" "$skipped" "$retried" >&2
[ "$failed" -eq 0 ] && [ "$passed" -gt 0 ]
