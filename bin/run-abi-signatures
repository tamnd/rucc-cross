#!/bin/sh
# Build the compiler's signature corpus with the reference and run it, on every target that has a
# way to run a binary.
#
# usage: bin/run-abi-signatures [directory] [tuple]...
#
# The directory holds the output of `cargo xtask abi-signatures` in the compiler repository. It
# defaults to $RUCC_ABI_SIGNATURES and then to ../rucc/tests/abi-signatures, which is where it is
# when the two repositories sit side by side.
#
# This is the reference against reference build of the four that spec/cross-compile/14-testing.md
# section 14.3 describes, run on every architecture rather than on the one with a back end. It
# cannot be a differential, because the other three builds need rucc to emit code for the target
# and today it emits code for one of them. What it is instead is the control, and the control is
# worth running on its own for two reasons.
#
# The corpus is generated, and a generated program is a program nobody read. Compiling it for every
# row already catches the shapes the reference rejects, and bin/compile-abi-signatures does that.
# Running it catches the ones the reference accepts and then gets wrong, or that the corpus is
# wrong about: a value checked against the wrong promoted type, an aggregate whose initializer does
# not match the check, a `long double` whose bit pattern differs between architectures. Those are
# corpus bugs and they are far cheaper to find here than inside a differential where the answer is
# supposed to mean something about rucc.
#
# The second reason is section 14.4's divergence list. Every architecture's emulator has to be
# characterized before an emulated pass is worth anything, and the way to characterize it is to run
# a program whose answer is known on it, many times. That is exactly this. A crash here is qemu,
# because every instruction in the binary came from the reference compiler, and the retry count is
# printed rather than swallowed so the rate can be read off the log.
#
# What runs: the musl rows and the row this machine is. The glibc rows link dynamically against a
# loader and a libc that are not on this disk, the android rows have no bionic here at all, and the
# Darwin and Windows rows need a different kind of emulator than qemu user mode. run-corpus gives
# the same reasons at more length and skips the same rows, on purpose, so the two runners cover the
# same set and a target does not quietly appear in one and not the other.

set -eu

here=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)

die() { printf 'run-abi-signatures: %s\n' "$*" >&2; exit 1; }

corpus=${RUCC_ABI_SIGNATURES:-$here/../rucc/tests/abi-signatures}
if [ $# -gt 0 ] && [ -d "$1" ]; then
	corpus=$1
	shift
fi
[ -d "$corpus" ] || die "$corpus is not a directory, generate it with cargo xtask abi-signatures"
for name in abi.h caller.c callee.c report.c; do
	[ -f "$corpus/$name" ] || die "$corpus has no $name in it"
done

if [ $# -gt 0 ]; then
	tuples=$*
else
	tuples=$(awk -F'\t' '/^[^#]/ && NF > 1 && $4 != "-" { print $1 }' "$here/targets")
fi

# How many times a crash is tried again before it is reported. Three, for the reason in
# xtask/src/differential.rs in the compiler repository: qemu drops programs on the floor at a rate
# that is small but is not zero, and a harness that reports the first crash as a finding sends
# somebody after a bug that is not there. A wrong value is believed the first time, because no
# emulator has ever been observed to change one number in a program and leave it running.
TRIES=3

machine=$(uname -m)
case $machine in
x86_64 | amd64) machine=x86_64 ;;
aarch64 | arm64) machine=aarch64 ;;
*) machine=unknown ;;
esac
case $(uname -s) in
Linux) native=$machine-linux-gnu ;;
Darwin) native=$machine-macos ;;
*) native=$machine-unknown ;;
esac

out=$(mktemp -d)
trap 'rm -rf "$out"' EXIT INT TERM

passed=0
failed=0
skipped=0
retried=0

for tuple in $tuples; do
	runner=$(awk -F'\t' -v t="$tuple" '$1 == t { print $4 }' "$here/targets")
	[ -n "$runner" ] || die "$tuple is not a row of the targets table"

	how=emulated
	if [ "$tuple" = "$native" ]; then
		runner=""
		how=hardware
	elif [ "$runner" = "-" ] || ! command -v "$runner" >/dev/null 2>&1; then
		printf '%-24s skipped, no %s on this machine\n' "$tuple" "${runner:--}"
		skipped=$((skipped + 1))
		continue
	fi

	link=-static
	reason=""
	case $tuple in
	*-macos | *-ios*)
		link=""
		;;
	*-android | *-android.*)
		reason="zig carries bionic's headers and not bionic, so nothing links"
		;;
	*-linux-gnu | *-linux-gnu.* | *-linux-gnueabi* | *-linux-gnux32)
		link=""
		if [ -n "$runner" ]; then
			reason="glibc links dynamically and its loader for $tuple is not on this machine"
		fi
		;;
	esac

	if [ -n "$reason" ]; then
		printf '%-24s skipped, %s\n' "$tuple" "$reason"
		skipped=$((skipped + 1))
		continue
	fi

	# -O0, the level the differential harness uses, and for its reason: a calling convention is
	# not an optimization, and a difference that only shows up at -O2 is a difference in what got
	# inlined into what. Nothing here is inlined across the boundary anyway, because the two
	# halves are separate translation units, so the level buys nothing and costs build time.
	binary=$out/sig
	# shellcheck disable=SC2086
	if ! "$here/bin/reference-cc" "$tuple" -std=c17 -Wall -Wextra -Werror -O0 $link \
		-I "$corpus" -o "$binary" \
		"$corpus/caller.c" "$corpus/callee.c" "$corpus/report.c" \
		2>"$out/build.log"; then
		printf '%-24s did not build\n' "$tuple"
		sed 's/^/    /' "$out/build.log" >&2
		failed=$((failed + 1))
		continue
	fi

	try=1
	while :; do
		# The status is read in the else branch rather than after the whole `if`, because
		# after a failed condition with no else the `if` itself has succeeded and `$?` is 0.
		# shellcheck disable=SC2086
		if $runner "$binary" >"$out/got" 2>&1; then
			if [ "$try" -gt 1 ]; then
				printf '%-24s ok, %s, after %d tries\n' "$tuple" "$how" "$try"
			else
				printf '%-24s ok, %s\n' "$tuple" "$how"
			fi
			passed=$((passed + 1))
			break
		else
			status=$?
		fi

		# Anything at or above 128 is a signal, which is the shape a qemu drop takes. The
		# corpus itself exits 1 when a value arrived in the wrong place, and that is an
		# answer rather than an accident, so it is reported the first time.
		if [ "$status" -lt 128 ] || [ "$try" -ge "$TRIES" ]; then
			printf '%-24s failed with status %d, %s, on try %d\n' \
				"$tuple" "$status" "$how" "$try"
			sed 's/^/    /' "$out/got" >&2
			failed=$((failed + 1))
			break
		fi

		retried=$((retried + 1))
		try=$((try + 1))
	done
done

printf 'abi-signatures: %d ran, %d failed, %d skipped, %d crashes tried again\n' \
	"$passed" "$failed" "$skipped" "$retried" >&2
[ "$failed" -eq 0 ] && [ "$passed" -gt 0 ]
