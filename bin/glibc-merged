#!/bin/sh
# Merge every glibc release in sysroots/manifest into the one header tree, which is the tree a target
# gets whichever release it asked for.
#
# usage: bin/glibc-merged
#        bin/glibc-merged --force
#        bin/glibc-merged --check <manifest> <manifest>
#
# Section 8.3 of the compiler's sysroot specification says one header tree per libc, with what
# differs between releases written as a conditional inside a single file rather than as a tree per
# release. Two thirds of that exist and neither third is here. bin/glibc-versions measured which
# files a conditional would have to be written into at all, and `rucc-headers` in the compiler's
# build-tools does the merging and checks its own output by reading every release back out of it.
# What has been missing is the producer, which is the thing that puts the releases in front of the
# tool and leaves a tree behind, and until there is one a target asking for 2.28 is handed one recent
# release's text. That is the open half of tamnd/rucc#926.
#
# The installs are bin/glibc-versions', and are not installed again here. That script already puts
# one install per release in the cache for its survey, both want the same eight, and sixteen
# configures for eight answers is not a trade anybody would make. So this reads what that one left
# behind and says to run it when it is not there, which is the relationship bin/glibc-headers already
# has with bin/kernel-headers.
#
# One ABI, and it is x86_64, for the reason bin/glibc-versions gives at length: which of glibc's own
# files change between releases is a fact about glibc's source rather than about a machine, and the
# part that does differ between ABIs is what bin/glibc-headers already split into seven family trees.
# Crossing the two, so that the tree is per family as well as per release, is the next piece of work
# and not this one. Nor does this tree carry the patched features.h and the gnu/stubs.h prologue that
# bin/glibc-headers writes, for the same reason: those belong to the split, and a tree that had them
# without the split would be a third thing to keep in step with the other two.
#
# The merge lives in the compiler's build-tools, so the compiler has to be checked out. $RUCC_SRC
# names it and it defaults to beside this repository, which is where bin/compile-abi-corpus looks for
# the corpus and where the workflows put it.
#
# The cache is $RUCC_CROSS_CACHE, and it defaults to ~/.cache/rucc-cross, so a produced tree survives
# a branch switch. Producing one that is already there is a no-op unless --force is given.

set -eu

here=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
cache=${RUCC_CROSS_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/rucc-cross}
pins=$here/sysroots/manifest
src=${RUCC_SRC:-$here/../rucc}
force=

# The compiler's checkout as an absolute path, because the merge is run from inside it and a relative
# one would be read from wherever this happened to be standing. The workflows check it out under the
# workspace and name it with a relative path, which is where this matters.
if [ -d "$src" ]; then
	src=$(CDPATH='' cd -- "$src" && pwd)
fi

say() { printf '%s\n' "$*" >&2; }
die() { say "glibc-merged: $*"; exit 1; }

sha256() {
	if command -v sha256sum >/dev/null 2>&1; then
		sha256sum "$1" | cut -d' ' -f1
	else
		shasum -a 256 "$1" | cut -d' ' -f1
	fi
}

# Everything under a directory, hashed, as manifest lines, in the C locale. The same function
# bin/glibc-headers has, minus the per file origin column it needs and this one does not: every file
# in that tree is one release's text or a patch of it, and every file in this one is all eight
# releases at once, so there is nothing a column could say per file that the header does not say
# once.
manifest_lines() {
	walk_root=$1
	walk_licence=$2
	(
		cd "$walk_root" || exit 1
		find . -type f ! -name manifest | sed 's|^\./||' | LC_ALL=C sort | while read -r walk_file; do
			printf '%s\t%s\t%s\t%s\n' \
				"$walk_file" glibc-merged "$(sha256 "$walk_file")" "$walk_licence"
		done
	)
}

# Every glibc release in sysroots/manifest, oldest first. The manifest is the list for the reason
# bin/glibc-versions gives: adding a release there adds it to the survey and to this merge at once,
# and a second list of releases anywhere else would be a second thing to forget. The sort is on the
# minor number rather than with sort -V, which is a GNU extension, and it is enough while every glibc
# release is 2 point something.
versions() {
	awk -F'\t' '$1 == "glibc" { print $2 }' "$pins" | sort -t. -k2,2n
}

produce() {
	root=$cache/glibc-merged
	if [ -f "$root/tree/manifest" ] && [ -z "$force" ]; then
		say "the merged tree is already in $root"
		printf '%s\n' "$root/tree/manifest"
		return 0
	fi

	list=$(versions)
	[ -n "$list" ] || die "sysroots/manifest has no glibc rows"
	count=$(printf '%s\n' "$list" | wc -l | tr -d ' ')
	[ "$count" -ge 2 ] ||
		die "sysroots/manifest has $count glibc release in it, and merging one release is copying it"
	licence=$(awk -F'\t' '$1 == "glibc" { print $3; exit }' "$pins")

	# The installs, which are the other script's and are checked for by name rather than assumed.
	# Every release or none: a merge over seven of the eight would succeed, produce a tree with
	# different conditionals in it, and say nothing about the release it left out.
	installs=$cache/glibc-versions
	for version in $list; do
		[ -f "$installs/install-$version/usr/include/features.h" ] ||
			die "glibc $version is not installed in $installs, so run bin/glibc-versions first"
	done

	[ -f "$src/build-tools/rucc-headers/Cargo.toml" ] ||
		die "$src is not a checkout of the compiler, so set RUCC_SRC to one"
	command -v cargo >/dev/null 2>&1 ||
		die "cargo is not on the path, and the merge is a program in the compiler's build-tools"

	work=$cache/glibc-merged.part
	rm -rf "$work"
	mkdir -p "$work"

	# One --release argument per install, oldest first, which is the order the tool wants. Built as a
	# string and passed unquoted, because a list is what this shell has.
	args=
	for version in $list; do
		args="$args --release $version=$installs/install-$version/usr/include"
	done

	say "merging $count releases, $(printf '%s' "$list" | tr '\n' ' ')"
	# shellcheck disable=SC2086
	# The arguments are a list and have to arrive as separate words. Every one of them is built above.
	(cd "$src" && cargo run -q -p rucc-headers --release -- \
		$args --out "$work/tree" --listing "$work/listing") ||
		die "the merge refused its own output, and what it said is above"

	# The record, which is this tree's rather than a sysroot's, for the reason bin/glibc-headers gives
	# about the one it writes: a sysroot manifest names the target it was produced for and this tree
	# is every glibc target's. The header carries every release the tree answers for, one line each,
	# because that is the whole claim being made about these bytes.
	{
		printf 'rucc glibc merged headers manifest 1\n'
		for version in $list; do
			printf 'glibc\t%s\n' "$version"
		done
		manifest_lines "$work/tree" "$licence"
	} >"$work/tree/manifest"

	rm -rf "$cache/glibc-merged"
	mv "$work" "$cache/glibc-merged"
	root=$cache/glibc-merged
	say "the merged tree is in $root/tree, $(grep -c '' "$root/tree/manifest") manifest lines, \
$(du -sk "$root/tree" | cut -f1)K"
	printf '%s\n' "$root/tree/manifest"
}

# Compare two manifests and say what differs, which is the reproducibility check. Two hosts, one set
# of pinned sources, one argument list, and the two records have to be the same file. The same
# function bin/glibc-headers has and the same reason for having it: document 02 claim 5 is that two
# hosts produce the same bytes for a target, and a claim nobody checks is one that broke a year ago.
check() {
	a=$1
	b=$2
	[ -f "$a" ] || die "$a is not a file"
	[ -f "$b" ] || die "$b is not a file"
	if cmp -s "$a" "$b"; then
		say "the two manifests are identical, $(grep -c '' "$a") lines"
		return 0
	fi
	say "the two manifests differ:"
	diff -u "$a" "$b" >&2 || true
	return 1
}

case ${1:-} in
--check)
	[ $# -eq 3 ] || die "usage: bin/glibc-merged --check <manifest> <manifest>"
	check "$2" "$3"
	;;
--force)
	force=yes
	produce
	;;
"") produce ;;
*) die "unknown argument $1" ;;
esac
