#!/bin/sh
# Merge every glibc release in sysroots/manifest into the one header tree, which is the tree a target
# gets whichever release it asked for.
#
# usage: bin/glibc-merged
#        bin/glibc-merged --force
#        bin/glibc-merged --check <manifest> <manifest>
#
# Section 8.3 of the compiler's sysroot specification says one header tree per libc, with what
# differs between releases written as a conditional inside a single file rather than as a tree per
# release, and with the part that differs between machines split out into the directory the compiler
# searches first. This is where the two halves meet. bin/glibc-headers installs one release for every
# ABI and splits it into a generic tree and seven family trees, `rucc-headers` in the compiler's
# build-tools merges trees over a release dimension and checks its own output by reading every
# release back out of it, and this puts one in front of the other.
#
# The inputs are bin/glibc-headers' split trees, one per release, and they are not installed again
# here. That script takes --release and leaves a named tree in the cache, so this reads what it left
# and says to run it when it is not there, which is the relationship it already has with
# bin/kernel-headers. Each tree's own manifest is left out of the merge, because a manifest is a
# statement about a tree rather than a file in it and merging eight of them would put a ninth,
# meaningless one in the output.
#
# So what comes out is the whole tree, and not a sample of it. Every ABI, the patched features.h and
# the synthesized gnu/stubs.h included, because those are bin/glibc-headers' and this merges what
# that leaves behind rather than reaching around it.
#
# The grid is ragged and the merge is what makes that harmless. glibc learned loongarch64 in 2.36, so
# the loongarch directory is in four of the eight inputs, and a file that only some releases have is
# written with a guard naming the ones that do. A target asking for a release older than the oldest
# input gets the oldest input's text, which is what `rucc-headers` does by leaving the oldest branch
# without a lower bound.
#
# The merge lives in the compiler's build-tools, so the compiler has to be checked out. $RUCC_SRC
# names it and it defaults to beside this repository, which is where bin/compile-abi-corpus looks for
# the corpus and where the workflows put it.
#
# The cache is $RUCC_CROSS_CACHE, and it defaults to ~/.cache/rucc-cross, so a produced tree survives
# a branch switch. Producing one that is already there is a no-op unless --force is given.

set -eu

here=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
cache=${RUCC_CROSS_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/rucc-cross}
pins=$here/sysroots/manifest
src=${RUCC_SRC:-$here/../rucc}
force=

# The compiler's checkout as an absolute path, because the merge is run from inside it and a relative
# one would be read from wherever this happened to be standing. The workflows check it out under the
# workspace and name it with a relative path, which is where this matters.
if [ -d "$src" ]; then
	src=$(CDPATH='' cd -- "$src" && pwd)
fi

say() { printf '%s\n' "$*" >&2; }
die() { say "glibc-merged: $*"; exit 1; }

sha256() {
	if command -v sha256sum >/dev/null 2>&1; then
		sha256sum "$1" | cut -d' ' -f1
	else
		shasum -a 256 "$1" | cut -d' ' -f1
	fi
}

# Everything under a directory, hashed, as manifest lines, in the C locale. The same function
# bin/glibc-headers has, with the same two special cases: every file here is every release of one of
# its files at once, so the origin column says what the file is rather than which release it came
# from, and the two that are not glibc's own text are still the two that are not glibc's own text.
manifest_lines() {
	walk_root=$1
	walk_licence=$2
	(
		cd "$walk_root" || exit 1
		find . -type f ! -name manifest | sed 's|^\./||' | LC_ALL=C sort | while read -r walk_file; do
			case $walk_file in
			generic/features.h) walk_origin=glibc-merged-patched ;;
			*/gnu/stubs.h) walk_origin=glibc-merged-stubs-prologue ;;
			*) walk_origin=glibc-merged ;;
			esac
			printf '%s\t%s\t%s\t%s\n' \
				"$walk_file" "$walk_origin" "$(sha256 "$walk_file")" "$walk_licence"
		done
	)
}

# Every glibc release in sysroots/manifest, oldest first. The manifest is the list for the reason
# bin/glibc-versions gives: adding a release there adds it to the survey and to this merge at once,
# and a second list of releases anywhere else would be a second thing to forget. The sort is on the
# minor number rather than with sort -V, which is a GNU extension, and it is enough while every glibc
# release is 2 point something.
versions() {
	awk -F'\t' '$1 == "glibc" { print $2 }' "$pins" | sort -t. -k2,2n
}

produce() {
	root=$cache/glibc-merged
	if [ -f "$root/tree/manifest" ] && [ -z "$force" ]; then
		say "the merged tree is already in $root"
		printf '%s\n' "$root/tree/manifest"
		return 0
	fi

	list=$(versions)
	[ -n "$list" ] || die "sysroots/manifest has no glibc rows"
	count=$(printf '%s\n' "$list" | wc -l | tr -d ' ')
	[ "$count" -ge 2 ] ||
		die "sysroots/manifest has $count glibc release in it, and merging one release is copying it"
	licence=$(awk -F'\t' '$1 == "glibc" { print $3; exit }' "$pins")

	# The split trees, which are the other script's and are checked for by name rather than assumed.
	# Every release or none: a merge over seven of the eight would succeed, produce a tree with
	# different conditionals in it, and say nothing about the release it left out.
	for version in $list; do
		[ -f "$cache/glibc-headers-$version/manifest" ] ||
			die "glibc $version is not split in $cache, so run bin/glibc-headers --release $version first"
	done

	[ -f "$src/build-tools/rucc-headers/Cargo.toml" ] ||
		die "$src is not a checkout of the compiler, so set RUCC_SRC to one"
	command -v cargo >/dev/null 2>&1 ||
		die "cargo is not on the path, and the merge is a program in the compiler's build-tools"

	work=$cache/glibc-merged.part
	rm -rf "$work"
	mkdir -p "$work"

	# One --release argument per input, oldest first, which is the order the tool wants. Built as a
	# string and passed unquoted, because a list is what this shell has. The copy is what drops the
	# manifest, and it is a copy rather than a link farm because the tool walks what it is given and a
	# tree with one file missing is easier to make than an argument that says to skip one, and because
	# the step after this one moves files about.
	args=
	for version in $list; do
		mkdir -p "$work/in-$version"
		cp -R "$cache/glibc-headers-$version/." "$work/in-$version/"
		rm -f "$work/in-$version/manifest"
		args="$args --release $version=$work/in-$version"
	done

	# A path that is generic in one release and per family in another has to be made per family in both,
	# and it is the one way these eight trees could be merged into something that silently does not work.
	# bin/glibc-headers derives its split by asking whether the ABIs of a release agree about a file, and
	# eight releases do not have to give that the same answer. glibc unified bits/stat.h across
	# architectures in 2.34, so it is per family in 2.28 and 2.31 and generic in the six releases after
	# them, and bits/time64.h went the other way. Merged as they are, the tree would carry such a file in
	# both places, each copy guarded to the releases that put it there, and rucc-sysroot searches the
	# family directory before the generic one: asking for 2.34 would find the family copy and read a
	# guard saying that release does not have the file.
	#
	# So the generic copy is pushed down into every family the release has, which is a move rather than a
	# rewrite and leaves each release reassembling exactly as it did. Seventeen paths need it today, all
	# of them files glibc moved into or out of sysdeps between 2.28 and 2.44.
	paths_under() {
		(cd "$1" && find . -type f | sed 's|^\./||')
	}
	for version in $list; do
		paths_under "$work/in-$version/generic"
	done | LC_ALL=C sort -u >"$work/generic-paths"
	for version in $list; do
		for dir in "$work/in-$version"/*/; do
			[ "$(basename "$dir")" = generic ] && continue
			paths_under "$dir"
		done
	done | LC_ALL=C sort -u >"$work/family-paths"
	LC_ALL=C comm -12 "$work/generic-paths" "$work/family-paths" >"$work/both-paths"

	moved=0
	while read -r one; do
		[ -n "$one" ] || continue
		for version in $list; do
			[ -f "$work/in-$version/generic/$one" ] || continue
			for dir in "$work/in-$version"/*/; do
				[ "$(basename "$dir")" = generic ] && continue
				mkdir -p "$dir$(dirname "$one")"
				cp "$work/in-$version/generic/$one" "$dir$one"
			done
			rm -f "$work/in-$version/generic/$one"
			moved=$((moved + 1))
		done
	done <"$work/both-paths"
	say "$(grep -c '' "$work/both-paths") paths are generic in one release and per family in another, \
and $moved copies of them were pushed down into the families"

	say "merging $count releases, $(printf '%s' "$list" | tr '\n' ' ')"
	# shellcheck disable=SC2086
	# The arguments are a list and have to arrive as separate words. Every one of them is built above.
	# What the merge reports goes to stderr with everything else this says, because stdout is the
	# path of the record and a caller reads it with $(...).
	(cd "$src" && cargo run -q -p rucc-headers --release -- \
		$args --out "$work/tree" --listing "$work/listing") >&2 ||
		die "the merge refused its own output, and what it said is above"

	for version in $list; do
		rm -rf "$work/in-$version"
	done

	# The record, which is this tree's rather than a sysroot's, for the reason bin/glibc-headers gives
	# about the one it writes: a sysroot manifest names the target it was produced for and this tree is
	# every glibc target's. The header carries every release the tree answers for, one line each,
	# because that is the whole claim being made about these bytes.
	{
		printf 'rucc glibc merged headers manifest 1\n'
		for version in $list; do
			printf 'glibc\t%s\n' "$version"
		done
		manifest_lines "$work/tree" "$licence"
	} >"$work/tree/manifest"

	rm -rf "$cache/glibc-merged"
	mv "$work" "$cache/glibc-merged"
	root=$cache/glibc-merged
	say "the merged tree is in $root/tree, $(grep -c '' "$root/tree/manifest") manifest lines, \
$(du -sk "$root/tree" | cut -f1)K"
	printf '%s\n' "$root/tree/manifest"
}

# Compare two manifests and say what differs, which is the reproducibility check. Two hosts, one set
# of pinned sources, one argument list, and the two records have to be the same file. The same
# function bin/glibc-headers has and the same reason for having it: document 02 claim 5 is that two
# hosts produce the same bytes for a target, and a claim nobody checks is one that broke a year ago.
check() {
	a=$1
	b=$2
	[ -f "$a" ] || die "$a is not a file"
	[ -f "$b" ] || die "$b is not a file"
	if cmp -s "$a" "$b"; then
		say "the two manifests are identical, $(grep -c '' "$a") lines"
		return 0
	fi
	say "the two manifests differ:"
	diff -u "$a" "$b" >&2 || true
	return 1
}

case ${1:-} in
--check)
	[ $# -eq 3 ] || die "usage: bin/glibc-merged --check <manifest> <manifest>"
	check "$2" "$3"
	;;
--force)
	force=yes
	produce
	;;
"") produce ;;
*) die "unknown argument $1" ;;
esac
