#!/bin/sh
# Run the reference C compiler for a rucc target.
#
# usage: bin/reference-cc <tuple> [argument]...
#
# The reference is zig cc by default, because it is the only toolchain that can be told to target
# every row of the table without a second installation, which is the property this whole line of
# work is trying to reproduce. Set RUCC_CROSS_REFERENCE=gcc to use the platform's cross gcc
# instead, for the rows where one exists, which is the comparison that matters when the two
# disagree and somebody has to decide which is right.
#
# Set RUCC_CROSS_REFERENCE=wasi-sdk to use clang from wasi-sdk for a wasm row. zig spells the three
# WASI previews as one target, so it cannot tell them apart, and the compiler repository holds its
# wasm macros against clang 23 from wasi-sdk 34. bin/facts uses it for the wasm rows for that
# reason.
#
# Nothing here knows what rucc does. This side of the comparison is deliberately independent, so
# that a bug in rucc's target table cannot quietly become the expected answer.

set -eu

here=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
cache=${RUCC_CROSS_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/rucc-cross}

die() { printf 'reference-cc: %s\n' "$*" >&2; exit 1; }

[ $# -ge 1 ] || die "usage: bin/reference-cc <tuple> [argument]..."
tuple=$1
shift

row=$(awk -F'\t' -v t="$tuple" '$1 == t' "$here/targets")
[ -n "$row" ] || die "$tuple is not a row of the targets table"

case ${RUCC_CROSS_REFERENCE:-zig} in
zig)
	spelling=$(printf '%s' "$row" | cut -f2)
	[ "$spelling" != "-" ] || die "zig has no spelling for $tuple, and the targets table says why"
	version=$(awk -F'\t' '$1 == "zig" { print $2; exit }' "$here/toolchains/manifest")
	zig=$cache/zig-$version/zig
	[ -x "$zig" ] || die "zig $version is not installed, so run toolchains/install zig"
	exec "$zig" cc -target "$spelling" "$@"
	;;
gcc)
	prefix=$(printf '%s' "$row" | cut -f3)
	[ "$prefix" != "-" ] || die "no cross gcc exists for $tuple, and the targets table says so"

	# Ubuntu names the command $prefix-gcc for the ports that have an unversioned metapackage, and
	# only $prefix-gcc-<n> for the ones that do not, which today is loongarch64 and tomorrow is
	# whichever port is newest. Take the plain name when there is one and the highest numbered
	# otherwise, rather than leaving a row of the table with no second opinion over a naming
	# convention. The list is walked downwards and stops at the first hit, so a machine holding two
	# of them gets the newer one.
	cc=
	for suffix in "" -20 -19 -18 -17 -16 -15 -14 -13 -12 -11 -10 -9; do
		if command -v "$prefix-gcc$suffix" >/dev/null 2>&1; then
			cc=$prefix-gcc$suffix
			break
		fi
	done
	[ -n "$cc" ] || die "$prefix-gcc is not on the path, so run toolchains/install gcc-cross"
	exec "$cc" "$@"
	;;
wasi-sdk)
	# clang spells the WASI rows as rucc does, and wasm32-none as wasm32-unknown-unknown. The
	# sysroot is the wasi-sysroot in the same release, which is the one bin/wasi-sysroot takes the C
	# part of.
	case $tuple in
	wasm32-wasip1 | wasm32-wasip2 | wasm32-wasip3) spelling=$tuple ;;
	wasm32-none) spelling=wasm32-unknown-unknown ;;
	*) die "wasi-sdk has no spelling for $tuple, because it is not a wasm row" ;;
	esac
	version=$(awk -F'\t' '$1 == "wasi-sdk" { print $2; exit }' "$here/toolchains/manifest")
	sdk=$cache/wasi-sdk-$version
	[ -x "$sdk/bin/clang" ] || die "wasi-sdk $version is not installed, so run toolchains/install wasi-sdk"
	exec "$sdk/bin/clang" --target="$spelling" --sysroot="$sdk/share/wasi-sysroot" "$@"
	;;
*)
	die "RUCC_CROSS_REFERENCE is ${RUCC_CROSS_REFERENCE}, and it has to be zig, gcc or wasi-sdk"
	;;
esac
