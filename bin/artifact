#!/bin/sh
# Pack a produced sysroot into the archive a rucc release pins, and print what the pin has to say.
#
# usage: bin/artifact <target>...
#        bin/artifact kernel-headers
#        bin/artifact --against <PROVENANCE> <target>...
#
# The last step of producing a sysroot and the first step of shipping one. `rucc_sysroot::artifact`
# in the compiler is a table of one URL and one sha256 per target, and its own documentation says it
# is empty because nothing has published a file at one with the other. This is what publishes the
# file, and the line it prints is the row.
#
# What comes out is what `rucc_driver::install` expects, which is not a free choice: it runs the
# platform's own `tar -xzf` and it strips no component, so the archive is gzipped, and `manifest`,
# `include` and `lib` are at the top of it rather than under a directory named after the target. The
# staging directory it unpacks into is the thing that is named after the target, and an archive with
# its own wrapper directory would install a sysroot one level too deep.
#
# The archive is reproducible, which document 13 section 13.7 asks of every release artifact and
# which matters more here than it does for most: the sha256 of these bytes is compiled into a rucc
# release, so two people packing the same tree have to get the same file or the pin is a fact about
# whoever ran this rather than about the tree. Four things are what a tar of a directory would
# otherwise carry from the machine it ran on, and all four are pinned down: the member order is
# sorted rather than the filesystem's, the modification times are zero rather than when the files
# were copied, the owner and group are 0 rather than whoever produced the tree, and the permissions
# are normalised, because the directories come from `mkdir` and would otherwise carry the umask of
# the shell that made them. gzip is told not to write the file name and timestamp into its header
# for the same reason.
#
# GNU tar, then, because `--sort` is a GNU option and the BSD tar on a mac has nothing that answers
# for it. That is a real limit and it is checked rather than worked around: a sysroot packed with an
# unsorted member list is an archive whose hash depends on a directory walk, which is exactly the
# thing this is here to prevent.
#
# kernel-headers in place of a target packs the Linux uapi tree bin/kernel-headers produces, which is
# one tree for every Linux target rather than a part of each one, and so it is its own archive the
# same way it is its own directory in the compiler's cache. A Linux sysroot is fetched as two files,
# its own and this one, and the second is shared by every Linux target a machine has fetched. The
# archive has the same shape as a sysroot's, with the tree's own `manifest` at the top beside the
# per architecture directories and `generic`, and it is packed by the same pipeline for the same
# reasons.
#
# The cache is $RUCC_CROSS_CACHE, the same one the producers write into, and the archives land in
# artifacts/ beside sysroots/ rather than inside the tree they are made of, because a sysroot that
# contained its own archive would not hash to what its manifest says.

# --against is the other direction: it takes the compiler's PROVENANCE, which is the release's own
# list of what it pins, and asks whether the archive this machine just packed is the file named
# there. That is the question the reproducibility rule of document 13 section 13.6 actually rests on,
# and until it is asked every night the pin is a hash somebody pasted once. Holding a fresh build
# against a fixed published hash is a stronger check than holding two fresh builds against each
# other, because two runs can agree on the wrong thing and neither of them can drift away from the
# bytes people are downloading without this noticing. PROVENANCE is the right file to read rather
# than the Rust table behind it: it is generated from that table, it is committed, and it is tab
# separated, so this needs no toolchain to parse and no copy of the pins that could fall behind.

set -eu

cache=${RUCC_CROSS_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/rucc-cross}

say() { printf '%s\n' "$*" >&2; }
die() { say "artifact: $*"; exit 1; }

sha256() {
	if command -v sha256sum >/dev/null 2>&1; then
		sha256sum "$1" | cut -d' ' -f1
	else
		shasum -a 256 "$1" | cut -d' ' -f1
	fi
}

gnu_tar() {
	for candidate in "${TAR:-tar}" gtar; do
		command -v "$candidate" >/dev/null 2>&1 || continue
		case $("$candidate" --version 2>/dev/null | head -1) in
		"tar (GNU tar)"*) printf '%s\n' "$candidate"; return 0 ;;
		esac
	done
	die "no GNU tar on the path, and the member order has to be sorted rather than the filesystem's"
}

pack() {
	target=$1
	if [ "$target" = kernel-headers ]; then
		root=$cache/kernel-headers
		[ -f "$root/manifest" ] ||
			die "no kernel header tree has been produced, so run bin/kernel-headers first"
		[ "$(head -1 "$root/manifest")" = "rucc kernel headers manifest 1" ] ||
			die "$root/manifest is not the record of a kernel header tree"
		out=$cache/artifacts/$(archive_name "$target")
	else
		root=$cache/sysroots/$target
		[ -f "$root/manifest" ] ||
			die "no sysroot for $target has been produced, so there is nothing to pack"
		awk -F'\t' -v t="$target" 'NR == 2 && $1 == "target" && $2 == t { found = 1 } END { exit !found }' \
			"$root/manifest" ||
			die "$root/manifest does not say it is the sysroot for $target"
		out=$cache/artifacts/$(archive_name "$target")
	fi

	tar=$(gnu_tar)
	mkdir -p "$cache/artifacts"

	# One pipeline rather than tar's own -z, because gzip needs -n and tar has no way to pass it on.
	"$tar" --sort=name --format=gnu --mtime=@0 --owner=0 --group=0 --numeric-owner \
		--mode='u=rwX,go=rX' -C "$root" -cf - . | gzip -n -9 >"$out.part"
	mv "$out.part" "$out"

	# The three fields of a `Pinned` row, in the order the struct has them, with the size after so
	# that a person deciding whether to publish it knows what they are uploading. The URL is not this
	# script's to know: it is where somebody puts the file, and the row is written when they have.
	printf '%s\t%s\t%s\t%s\n' \
		"$target" "$(basename "$out")" "$(sha256 "$out")" "$(du -k "$out" | cut -f1)K"
}

# The field of PROVENANCE's row for one target, or nothing if the release pins nothing for it. One
# call per field rather than one call returning the row, because splitting a tab separated line back
# up in the shell is the sort of thing that works until a value is empty. The kernel tree's row starts
# with `tree` rather than `target`, and the fields after the name are in the same places.
pinned() {
	awk -F'\t' -v t="$2" -v n="$3" \
		'($1 == "target" || $1 == "tree") && $2 == t && $3 == "pinned" { print $n; exit }' "$1"
}

# The file one name is packed into.
archive_name() {
	if [ "$1" = kernel-headers ]; then
		printf 'rucc-kernel-headers.tar.gz\n'
	else
		printf 'rucc-sysroot-%s.tar.gz\n' "$1"
	fi
}

# One target's archive against the row PROVENANCE has for it. A target with no row is not a failure
# and is reported as such, because the table is allowed to pin fewer targets than this repository can
# produce and a producer running ahead of a publisher is the normal order of things. A row whose file
# name is not the one packed here is a failure, since a pin that points at a differently named file
# is a pin at something else.
against() {
	provenance=$1
	target=$2
	name=$(archive_name "$target")
	out=$cache/artifacts/$name
	[ -f "$out" ] || die "$out has not been packed, so there is nothing to hold against the pin"

	url=$(pinned "$provenance" "$target" 4)
	want=$(pinned "$provenance" "$target" 5)
	if [ -z "$want" ]; then
		say "$target: $provenance pins nothing for it, so there is nothing to compare"
		return 0
	fi

	[ "${url##*/}" = "$name" ] ||
		die "$target: the pinned URL names ${url##*/} and this packs $name"

	have=$(sha256 "$out")
	if [ "$have" = "$want" ]; then
		say "$target: reproduces the pinned artifact, $want"
		return 0
	fi
	say "$target: this machine packed $have and $provenance pins $want"
	say "$target: the pinned file is $url"
	return 1
}

case ${1:-} in
--against)
	[ $# -ge 3 ] || die "usage: bin/artifact --against <PROVENANCE> <target>..."
	provenance=$2
	[ -f "$provenance" ] || die "$provenance is not a file"
	shift 2
	bad=
	for one in "$@"; do
		against "$provenance" "$one" || bad=yes
	done
	[ -z "$bad" ] || die "a produced archive is not the one the compiler pins"
	;;
"")
	die "usage: bin/artifact <target>..."
	;;
*)
	for one in "$@"; do
		pack "$one"
	done
	;;
esac
