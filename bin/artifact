#!/bin/sh
# Pack a produced sysroot into the archive a rucc release pins, and print what the pin has to say.
#
# usage: bin/artifact <target>...
#
# The last step of producing a sysroot and the first step of shipping one. `rucc_sysroot::artifact`
# in the compiler is a table of one URL and one sha256 per target, and its own documentation says it
# is empty because nothing has published a file at one with the other. This is what publishes the
# file, and the line it prints is the row.
#
# What comes out is what `rucc_driver::install` expects, which is not a free choice: it runs the
# platform's own `tar -xzf` and it strips no component, so the archive is gzipped, and `manifest`,
# `include` and `lib` are at the top of it rather than under a directory named after the target. The
# staging directory it unpacks into is the thing that is named after the target, and an archive with
# its own wrapper directory would install a sysroot one level too deep.
#
# The archive is reproducible, which document 13 section 13.7 asks of every release artifact and
# which matters more here than it does for most: the sha256 of these bytes is compiled into a rucc
# release, so two people packing the same tree have to get the same file or the pin is a fact about
# whoever ran this rather than about the tree. Four things are what a tar of a directory would
# otherwise carry from the machine it ran on, and all four are pinned down: the member order is
# sorted rather than the filesystem's, the modification times are zero rather than when the files
# were copied, the owner and group are 0 rather than whoever produced the tree, and the permissions
# are normalised, because the directories come from `mkdir` and would otherwise carry the umask of
# the shell that made them. gzip is told not to write the file name and timestamp into its header
# for the same reason.
#
# GNU tar, then, because `--sort` is a GNU option and the BSD tar on a mac has nothing that answers
# for it. That is a real limit and it is checked rather than worked around: a sysroot packed with an
# unsorted member list is an archive whose hash depends on a directory walk, which is exactly the
# thing this is here to prevent.
#
# The cache is $RUCC_CROSS_CACHE, the same one the producers write into, and the archives land in
# artifacts/ beside sysroots/ rather than inside the tree they are made of, because a sysroot that
# contained its own archive would not hash to what its manifest says.

set -eu

cache=${RUCC_CROSS_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/rucc-cross}

say() { printf '%s\n' "$*" >&2; }
die() { say "artifact: $*"; exit 1; }

sha256() {
	if command -v sha256sum >/dev/null 2>&1; then
		sha256sum "$1" | cut -d' ' -f1
	else
		shasum -a 256 "$1" | cut -d' ' -f1
	fi
}

gnu_tar() {
	for candidate in "${TAR:-tar}" gtar; do
		command -v "$candidate" >/dev/null 2>&1 || continue
		case $("$candidate" --version 2>/dev/null | head -1) in
		"tar (GNU tar)"*) printf '%s\n' "$candidate"; return 0 ;;
		esac
	done
	die "no GNU tar on the path, and the member order has to be sorted rather than the filesystem's"
}

pack() {
	target=$1
	root=$cache/sysroots/$target
	[ -f "$root/manifest" ] ||
		die "no sysroot for $target has been produced, so there is nothing to pack"
	awk -F'\t' -v t="$target" 'NR == 2 && $1 == "target" && $2 == t { found = 1 } END { exit !found }' \
		"$root/manifest" ||
		die "$root/manifest does not say it is the sysroot for $target"

	tar=$(gnu_tar)
	out=$cache/artifacts/rucc-sysroot-$target.tar.gz
	mkdir -p "$cache/artifacts"

	# One pipeline rather than tar's own -z, because gzip needs -n and tar has no way to pass it on.
	"$tar" --sort=name --format=gnu --mtime=@0 --owner=0 --group=0 --numeric-owner \
		--mode='u=rwX,go=rX' -C "$root" -cf - . | gzip -n -9 >"$out.part"
	mv "$out.part" "$out"

	# The three fields of a `Pinned` row, in the order the struct has them, with the size after so
	# that a person deciding whether to publish it knows what they are uploading. The URL is not this
	# script's to know: it is where somebody puts the file, and the row is written when they have.
	printf '%s\t%s\t%s\t%s\n' \
		"$target" "$(basename "$out")" "$(sha256 "$out")" "$(du -k "$out" | cut -f1)K"
}

[ $# -gt 0 ] || die "usage: bin/artifact <target>..."

for one in "$@"; do
	pack "$one"
done
