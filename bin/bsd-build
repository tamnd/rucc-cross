#!/bin/sh
# Compile and link the BSD programs with rucc and GNU ld, for a stock BSD release.
#
# usage: RUCC=<rucc> bin/bsd-build freebsd|netbsd amd64|aarch64|riscv64 <out>
#
# The tree is the release's own, from bin/bsd-sysroot, and the linker is GNU ld from bin/bsd-ld,
# which is what GCC on each BSD runs. The compiler is given the target, the tree and a -B for the
# linker and nothing else, so the start files, the libraries and the link line are the ones the
# compiler works out for itself.
#
# The programs are the executing corpus that runs everywhere: corpus/exec, the parts of
# corpus/glibc that are POSIX rather than glibc, and corpus/bsd, which is the thread local storage
# and the start up code that each BSD does its own way. Each is built three ways: with no options,
# which is whatever kind of executable the compiler makes for the system by default, the same at
# -O2, and a static program. On NetBSD amd64 a fourth time as a static PIE, which NetBSD's GCC
# links and the others do not, and whose crt0.o relocates the program before anything else runs.
# NetBSD's crt0.o does that only on x86 (HAS_RELOCATE_SELF in lib/csu/common/crt0-common.c), so on
# aarch64 and riscv64 a static PIE is never relocated, whichever compiler made it, and it is not
# built there. dso.c is not built static, because it is a program and a shared object.
#
# Nothing runs here, because this machine is not a BSD. <out> gets the programs, their expected
# output, bin/bsd-run and a list of what was meant to be built, and bin/bsd-run on the BSD runs
# them. A program that did not build is on the list and not in the directory, and bin/bsd-run
# reports it as a failure, so the one report says what failed to build and what failed to run.
# The compiler's own words for a failed build are in <out>/build.log.

set -eu

here=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)

say() { printf '%s\n' "$*" >&2; }
die() { say "bsd-build: $*"; exit 1; }

[ $# -eq 3 ] || die "usage: RUCC=<rucc> bin/bsd-build freebsd|netbsd amd64|aarch64|riscv64 <out>"
system=$1
arch=$2
out=$3
[ -n "${RUCC:-}" ] || die "RUCC is not set, and it has to name the compiler"
case $arch in
amd64) cpu=x86_64 ;;
aarch64 | riscv64) cpu=$arch ;;
*) die "$arch is not amd64, aarch64 or riscv64" ;;
esac
case $system in
freebsd) triple=$cpu-unknown-freebsd15.1 ;;
netbsd) triple=$cpu-unknown-netbsd ;;
*) die "$system is not freebsd or netbsd" ;;
esac

root=$("$here/bin/bsd-sysroot" "$system" "$arch")
ld=$("$here/bin/bsd-ld" "$triple")

rm -rf "$out"
mkdir -p "$out"
cp "$here/bin/bsd-run" "$out/run"
log=$out/build.log
: >"$log"

# The corpus, as directory and name.
programs="exec/hello glibc/dirent glibc/math glibc/signal glibc/stat glibc/thread glibc/time"
programs="$programs bsd/tls bsd/ctor bsd/dso"

cc() {
	printf '\n$ rucc %s\n' "$*" >>"$log"
	"$RUCC" --target="$triple" --sysroot="$root" -B "$ld" "$@" >>"$log" 2>&1
}

variants="default O2 static"
[ "$system.$arch" = netbsd.amd64 ] && variants="$variants static-pie"

built=0
failed=0
for program in $programs; do
	name=${program#*/}
	# A system that runs a program differently has its own expected output: NetBSD runs the
	# destructors in .fini_array first to last, where FreeBSD and glibc run them last to first.
	expected=$here/corpus/$program.expected
	[ -f "$here/corpus/$program.$system.expected" ] && expected=$here/corpus/$program.$system.expected
	cp "$expected" "$out/$name.expected"
	for variant in $variants; do
		case $variant in
		default) flags="" ;;
		O2) flags="-O2" ;;
		static) flags="-static" ;;
		# `-static -pie` and not `-static-pie`, because NetBSD's GCC has no spec for the one word
		# and links an ordinary program for it, and reads the two words together as a static PIE.
		# With -fPIE, because its code is not position independent unless it is told.
		static-pie) flags="-fPIE -static -pie" ;;
		esac
		case $name.$variant in dso.static*) continue ;; esac
		# NetBSD's libc sets up the thread local storage of a static program itself, and on aarch64
		# and riscv64 it puts the block straight after the thread control block and does not align
		# it (lib/libc/tls/tls.c), where the offsets the linker works out take it as aligned. tls.c
		# has a variable aligned to 64, so in a static program for those two the aarch64 code reads
		# the wrong bytes and the riscv64 variable is not aligned, whichever compiler made it. GCC
		# folds the alignment test in tls.c to true, so its riscv64 program does not show the second.
		# The dynamic builds still run, as ld.elf_so aligns the block.
		case $system.$arch.$name.$variant in netbsd.aarch64.tls.static | netbsd.riscv64.tls.static) continue ;; esac
		printf '%s %s\n' "$name" "$variant" >>"$out/programs"
		extra=""
		# The shared object is built for each way the program is, and named for it, and the
		# program finds it beside itself.
		if [ "$name" = dso ]; then
			lib=libdso.$variant.so
			# shellcheck disable=SC2086
			if ! cc $flags -shared -fPIC -Wl,-soname,"$lib" -o "$out/$lib" "$here/corpus/bsd/dso-lib.c"; then
				say "$name $variant: the shared object did not build"
				failed=$((failed + 1))
				continue
			fi
			extra="$out/$lib -Wl,-rpath,\$ORIGIN"
		fi
		# shellcheck disable=SC2086
		if cc $flags -pthread -o "$out/$name.$variant" "$here/corpus/$program.c" $extra -lm; then
			built=$((built + 1))
		else
			say "$name $variant: did not build"
			failed=$((failed + 1))
		fi
	done
done
say "$system $arch: $built built, $failed did not, the compiler's output is in $log"
