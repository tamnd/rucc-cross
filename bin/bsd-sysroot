#!/bin/sh
# Unpack the sysroot of a stock BSD release from its own distribution sets, and print where it is.
#
# usage: bin/bsd-sysroot freebsd|netbsd amd64|aarch64|riscv64
#
# The sets are the ones the release's installer writes to disk for that machine, pinned with a hash
# in sysroots/manifest: base.txz for FreeBSD, and base with comp for NetBSD, which keeps the
# headers, the start files and the static libraries in comp. The rows are named for the system,
# the machine and the set, such as netbsd-aarch64-comp. Nothing is built and
# nothing is changed. A program linked against the tree is linked against the same files the
# installed system loads, so a program that links here and fails to run there is the compiler's
# fault or the linker's, and not the tree's.
#
# Only lib, usr/lib and usr/include are taken out, which is everything a link and a compile read.
# The rest of a set is programs.
#
# The cache is $RUCC_CROSS_CACHE, and it defaults to ~/.cache/rucc-cross.

set -eu

here=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
cache=${RUCC_CROSS_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/rucc-cross}
pins=$here/sysroots/manifest

say() { printf '%s\n' "$*" >&2; }
die() { say "bsd-sysroot: $*"; exit 1; }

[ $# -eq 2 ] || die "usage: bin/bsd-sysroot freebsd|netbsd amd64|aarch64|riscv64"
system=$1
arch=$2
case $arch in
amd64 | aarch64 | riscv64) ;;
*) die "$arch is not amd64, aarch64 or riscv64" ;;
esac
case $system in
freebsd) sets="freebsd-$arch-base" ;;
netbsd) sets="netbsd-$arch-base netbsd-$arch-comp" ;;
*) die "$system is not freebsd or netbsd" ;;
esac

sha256() {
	if command -v sha256sum >/dev/null 2>&1; then
		sha256sum "$1" | cut -d' ' -f1
	else
		shasum -a 256 "$1" | cut -d' ' -f1
	fi
}

# The release is the version of the first set, and every set of one system has the same one.
version=$(awk -F'\t' -v s="$system-$arch-base" '$1 == s { print $2; exit }' "$pins")
[ -n "$version" ] || die "sysroots/manifest has no $system-$arch-base line"
into=$cache/$system-$version-$arch
if [ -f "$into/.complete" ]; then
	printf '%s\n' "$into"
	exit 0
fi

rm -rf "$into"
mkdir -p "$into"
for set in $sets; do
	line=$(awk -F'\t' -v s="$set" '$1 == s' "$pins")
	[ -n "$line" ] || die "sysroots/manifest has no $set line"
	[ "$(printf '%s' "$line" | cut -f2)" = "$version" ] || die "$set is not release $version"
	want=$(printf '%s' "$line" | cut -f4)
	url=$(printf '%s' "$line" | cut -f5)
	archive=$cache/$system-$version-$arch-$(basename "$url")
	if [ ! -f "$archive" ] || [ "$(sha256 "$archive")" != "$want" ]; then
		say "fetching $url"
		curl -fsSL --retry 3 -o "$archive.part" "$url"
		mv "$archive.part" "$archive"
	fi
	got=$(sha256 "$archive")
	if [ "$got" != "$want" ]; then
		rm -f "$archive"
		die "$(basename "$url") hashed to $got and sysroots/manifest says $want"
	fi
	# Each set names its files from ./, and a set without one of the three directories is fine:
	# NetBSD's base has no usr/include, and its comp has no lib. tar finds the compression for
	# itself, which is xz for every set but NetBSD's riscv64 ones, which are gzip.
	members=$(tar -tf "$archive" | awk '
		/^\.\/(lib|usr\/lib|usr\/include)\// { split($0, part, "/"); top = part[2] == "usr" ? "./usr/" part[3] : "./" part[2]; seen[top] = 1 }
		END { for (top in seen) print top }')
	[ -n "$members" ] || die "$(basename "$url") has none of lib, usr/lib and usr/include in it"
	say "unpacking $(basename "$url")"
	# shellcheck disable=SC2086
	tar -xf "$archive" -C "$into" $members
done
: >"$into/.complete"
printf '%s\n' "$into"
